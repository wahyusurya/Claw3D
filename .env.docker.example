# Secrets for docker-compose.yml (copy to .env.docker; keep it chmod 600, never commit it).

# Must equal API_SERVER_KEY in the Hermes profile's .env (Hermes API server auth).
HERMES_API_KEY=

# Required when the UI binds to a non-loopback host. Long random string, e.g.: openssl rand -hex 24
# Also works as a backup login: http://<host>:<port>/?token=<STUDIO_ACCESS_TOKEN>
STUDIO_ACCESS_TOKEN=

# Optional username/password login. Set these with ./set-login.sh (stores an scrypt hash only).
# STUDIO_LOGIN_USER=
# STUDIO_LOGIN_PASSWORD_HASH=
